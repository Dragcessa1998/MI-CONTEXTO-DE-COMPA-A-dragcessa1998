# API histórica de talento (Express) a través del proxy same-origin de Next.
NEXT_PUBLIC_API_URL=/talent-api
TALENT_API_INTERNAL_URL=http://127.0.0.1:4000

# API FastAPI acumulativa: auth, proveedores e incidentes. El navegador usa
# el proxy same-origin y Next resuelve el destino interno.
NEXT_PUBLIC_PLATFORM_API_URL=/platform-api
NEXT_PUBLIC_SUPPLIERS_API_URL=/platform-api
NEXT_PUBLIC_PLATFORM_WS_URL=/platform-api
PLATFORM_API_INTERNAL_URL=http://127.0.0.1:8000
