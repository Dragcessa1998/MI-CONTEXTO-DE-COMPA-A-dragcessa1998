# Copia este archivo como .env y sustituye el secreto antes de arrancar Compose.
WEBSITE_PORT=3000
BACKOFFICE_PORT=3001
BACKEND_PORT=8000

# Sólo el servidor Next usa este hostname interno de la red Docker.
PLATFORM_API_INTERNAL_URL=http://backend:8000

# El navegador llama al proxy same-origin de Next, no al hostname de Docker.
NEXT_PUBLIC_PLATFORM_API_URL=/platform-api
NEXT_PUBLIC_PLATFORM_WS_URL=ws://localhost:8000
NEXT_PUBLIC_SUPPLIERS_API_URL=/platform-api

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL/Supabase para job_runs, telemetry_events y reporting.
DATABASE_URL=postgresql://user:password@db-host:5432/nexova
# Opcional para backfills/pruebas: YYYY-MM-DD; sin valor usa ayer UTC.
# TARGET_DATE=2026-08-11
JOB_STALE_AFTER_MINUTES=360

# RAG comercial: usa una clave local real, nunca la incluyas en este archivo.
OPENAI_API_KEY=replace-with-an-openai-project-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_GENERATION_MODEL=gpt-5.6-luna
RAG_MIN_SCORE=0.35
QDRANT_URL=http://qdrant:6333
QDRANT_PORT=6333
