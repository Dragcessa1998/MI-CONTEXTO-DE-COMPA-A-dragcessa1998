# Copia este archivo como .env y sustituye el secreto antes de arrancar Compose.
WEBSITE_PORT=3000
BACKOFFICE_PORT=3001
BACKEND_PORT=8000

# Sólo el servidor Next usa este hostname interno de la red Docker.
PLATFORM_API_INTERNAL_URL=http://backend:8000

# El navegador llama al proxy same-origin de Next, no al hostname de Docker.
NEXT_PUBLIC_PLATFORM_API_URL=/platform-api
NEXT_PUBLIC_SUPPLIERS_API_URL=/platform-api

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API, worker and Flower use the same Redis broker/result backend in Compose.
REDIS_URL=redis://redis:6379/0
