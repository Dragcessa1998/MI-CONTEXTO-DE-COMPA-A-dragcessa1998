{
  "name": "nexova-talent-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hito 5 — API central de Nexova (candidatos, vacantes, scoring) en /services. Reutiliza la lógica de negocio del Hito 2 desde /src.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
