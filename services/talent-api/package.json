    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "4.22.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.11",
    "tsx": "4.23.12",
    "typescript": "^5.6.3"
  }
}
