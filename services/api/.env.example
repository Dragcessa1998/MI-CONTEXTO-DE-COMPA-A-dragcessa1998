# Genera un valor aleatorio de al menos 32 caracteres; nunca lo subas al repositorio.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Collector externo opcional para una fase posterior. El stub local recibe en
# /telemetry/events y no reenvía todavía.
TELEMETRY_ENDPOINT=https://telemetry.example.invalid/events

# Persistencia append-only de telemetría en Supabase. La service role key sólo
# vive en el entorno del backend; nunca se expone como NEXT_PUBLIC_*.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-server-only-service-role-key

# Usa `supabase` en producción. `local` lee el export sintético de data/raw y
# escribe un espejo ignorado por Git en data/eval para desarrollo reproducible.
PIPELINE_BACKEND=local
PIPELINE_LOCAL_SOURCE=../../data/raw/telemetry_events.sample.json
PIPELINE_STATE_DIR=../../data/eval
