# Genera un valor aleatorio de al menos 32 caracteres; nunca lo subas al repositorio.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
OPENAI_API_KEY=replace-with-an-openai-project-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_GENERATION_MODEL=gpt-5.6-luna
RAG_MIN_SCORE=0.35
MODEL_RATE_LIMIT_REQUESTS=10
MODEL_RATE_LIMIT_WINDOW_SECONDS=60
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
TRUSTED_HOSTS=localhost,127.0.0.1,backend,testserver
APP_ENV=development
# PostgreSQL/Supabase es la fuente de verdad obligatoria para los tickets RFP.
DATABASE_URL=postgresql://postgres:replace-me@db.example.supabase.co:5432/postgres
RFP_CHECKPOINT_DB=../../data/checkpoints/rfp-approvals.sqlite3
RFP_FINAL_DIR=../../data/final/rfps
# Local: omite QDRANT_URL y usa QDRANT_PATH. Docker: http://qdrant:6333.
QDRANT_PATH=../../data/qdrant
