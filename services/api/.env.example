# Genera un valor aleatorio de al menos 32 caracteres; nunca lo subas al repositorio.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_EXPIRE_MINUTES=30

# Resend: crea la clave en https://resend.com y no la subas al repositorio.
RESEND_API_KEY=re_replace-with-your-resend-key
PASSWORD_RESET_FROM_EMAIL=Nexova <onboarding@resend.dev>
PASSWORD_RESET_FRONTEND_URL=http://localhost:3000/reset-password
